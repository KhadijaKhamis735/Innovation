# Copy this file to `.env.local` (which is gitignored) and adjust
# for your local backend. The default below is the Android emulator
# loopback; iOS simulator and physical phones need different values.
#
# Android emulator → http://10.0.2.2:8080
# iOS simulator    → http://127.0.0.1:8080
# Physical phone   → http://<your-LAN-ip>:8080
# Production       → https://<your-api-domain>

EXPO_PUBLIC_API_URL=http://10.0.2.2:8080